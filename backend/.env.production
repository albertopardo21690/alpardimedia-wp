NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.alpardimedia.es

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alpardimedia_wp
DB_USER=alpardimedia_user
DB_PASSWORD=CAMBIA_ESTO_POR_PASSWORD_SEGURO

# JWT
JWT_SECRET=CAMBIA_ESTO_POR_SECRET_LARGO_Y_SEGURO_64_CHARS
JWT_EXPIRES_IN=7d

# WordPress
WP_CLI_PATH=/var/www/alpardimedia/bin/wp-cli.phar
WP_SITES_PATH=/var/www/alpardimedia/sites
PHP_BINARY=/usr/bin/php
WP_BASE_URL=https://app.alpardimedia.es/sites
MYSQL_BINARY=/usr/bin/mysql

# Logs
LOG_LEVEL=warn
